PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/rj_training

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# Frontend dev server URL (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Account lock after repeated failed sign-ins (GP1 Fig. 22)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# How long an invitation / password-reset link stays valid (FR1)
INVITE_EXPIRES_HOURS=72

# Largest training material upload in MB (FR7). Files go to backend/uploads/materials/
MATERIAL_MAX_MB=100

# --- AI Assistant (Phase 5: FR10–FR13) -------------------------------------
# OpenAI: embeddings (always) and moderation (NFR18). Anthropic: answers when
# LLM_PROVIDER=anthropic. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which model writes the answers: anthropic (default) or openai.
# LLM_MODEL defaults to claude-haiku-5-5 for anthropic; required for openai.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Claude effort: low keeps replies fast (target < 5 s)
LLM_EFFORT=low

# Must output 1536 numbers (embeddings.vector_data). Changing it means every
# SOP must be re-indexed (the SOP Library shows a "Re-index" hint).
EMBEDDING_MODEL=text-embedding-ada-002
MODERATION_MODEL=omni-moderation-latest
# How long one AI request may take before the SDK retries it (ms)
AI_TIMEOUT_MS=20000

# Retrieval: top-k chunks, and the similarity a chunk needs to be used.
# Leave RAG_MIN_SIMILARITY empty for the model's default (ada-002: 0.78).
RAG_TOP_K=5
RAG_MIN_SIMILARITY=
# Chunk size and overlap, in tokens (about 4 characters each)
RAG_CHUNK_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100

# Largest SOP upload in MB (FR13). Files go to backend/uploads/sops/
SOP_MAX_MB=20
# Questions each user may send per minute
CHAT_RATE_LIMIT_PER_MIN=20
# Set to 0 to stop the per-question latency line in the API log
CHAT_LOG_TIMINGS=1

# Set to 1 to run without API keys: fake embeddings, extractive answers, no
# moderation. Tests use it. Answer quality in this mode means nothing.
AI_FAKE=0

# Quoted because dotenv treats an unquoted # as the start of a comment
SEED_PASSWORD="RJtraining#2026"
