PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/rj_training

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# Frontend dev server URL (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Account lock after repeated failed sign-ins (GP1 Fig. 22)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Quoted because dotenv treats an unquoted # as the start of a comment
SEED_PASSWORD="RJtraining#2026"

# --- RAG spike (Phase 3) ---------------------------------------------------
# Embedding model must output 1536 dims to fit embeddings.vector_data.
# text-embedding-3-small also outputs 1536 and works as a drop-in, but you
# must re-ingest after switching — vectors from different models don't mix.
RAG_EMBEDDING_MODEL=text-embedding-ada-002
ANTHROPIC_MODEL=claude-haiku-5-5
# Set to 1 to run the pipeline offline with fake embeddings/answers (no API cost)
RAG_FAKE=0
